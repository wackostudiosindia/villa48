{
  "name": "villa48",
  "version": "1.0.0",
  "private": true,
  "description": "Villa 48 Farmhouse website: React + Tailwind CSS client served by an Express server.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir ../dist-ssr && node scripts/prerender.mjs",
    "start": "node server/index.js",
    "preview": "npm run build && npm start",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "lighthouse": "^13.6.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
